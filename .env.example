# Clerk keys from Maria (TEAM-01).

NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Paths the Clerk components use. These match the app routes.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Use the mock API in lib/mocks instead of a real backend. Not a secret.
# Set to false once every backend endpoint is live.
NEXT_PUBLIC_API_MOCKS=true

# Finished endpoints that skip the mocks while NEXT_PUBLIC_API_MOCKS=true.
# Comma-separated paths; each covers everything under it. Example: /api/profile,/api/courses
NEXT_PUBLIC_API_LIVE=

# Supabase, from Project Settings -> API Keys. Server only: never add NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# RateMyProfessors numbers next to instructors. Set to false to hide them everywhere.
NEXT_PUBLIC_SHOW_RMP=true
